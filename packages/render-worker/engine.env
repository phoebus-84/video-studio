FFMPEG_SHA256=79095572fe46ccc5eff689bc4a272ef331024a8264226e97856e3f155371af2b
# The same build for Windows engines (setup.sh under Git Bash).
FFMPEG_WIN_FILE=ffmpeg-n9.0.2-36-g6882969ce9-win64-gpl-9.0
FFMPEG_WIN_SHA256=10a8e6c92d82ab5af285e736f63a871db30568d311b33a87b0ecb2477ceb8292
