{
  "name": "@av/remotion-composer",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Renders a layered, kit-based edit timeline (studio.video/v1alpha2) with Remotion, then normalises loudness with FFmpeg",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "render-timeline": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "kits:lock": "node --import tsx scripts/kits.ts lock",
    "kits:previews": "node --import tsx scripts/kits.ts previews"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.505",
    "@remotion/renderer": "4.0.505",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.505",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  }
}
