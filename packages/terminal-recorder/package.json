{
  "name": "@av/terminal-recorder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Record a terminal session to video from a VHS tape. Knows nothing about episodes or pipelines.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
