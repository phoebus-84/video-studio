{
  "name": "@studio/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Trusted local backend connecting browser clients, Pi RPC, and filesystem production state",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node --enable-source-maps dist/index.js",
    "dev": "tsx watch src/index.ts config.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ test/",
    "typecheck": "tsc --noEmit",
    "contract:generate": "tsx src/contract/generate.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.300",
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8",
    "@fastify/static": "^6.12.0",
    "@fastify/websocket": "^10.0.1",
    "@studio/adapters": "workspace:*",
    "@studio/pipelines": "workspace:*",
    "@studio/runtime": "workspace:*",
    "fastify": "^4.28.0",
    "pino": "^9.3.0",
    "pino-pretty": "^11.2.0",
    "uuid": "^10.0.0",
    "yaml": "^2.9.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "ws": "^8.21.3"
  }
}
