{
  "name": "@studio/episode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An episode on disk, produced: its narration manifest and scene images, its edit timeline built or compiled from its spec, checked against its series' rules, rendered",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./testing": {
      "import": "./dist/testing.js",
      "types": "./dist/testing.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@av/elevenlabs": "workspace:*",
    "@av/archive-media": "workspace:*",
    "@av/audio-edit": "workspace:*",
    "@av/remotion-composer": "workspace:*",
    "@studio/contracts": "workspace:*",
    "@studio/series": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
