 "$defs": {
  "Id": {
   "type": "string",
   "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
  },
  "Cue": {
   "description": "A time in the block: seconds from its start, \"end\" (its take's end), or the n-th occurrence (default 1) of a word in its guide take, plus an offset.",
   "oneOf": [
    {
     "type": "number",
     "minimum": 0
    },
    {
     "const": "end"
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "word"
     ],
     "properties": {
      "word": {
       "type": "string",
       "minLength": 1,
       "maxLength": 40
      },
      "n": {
       "type": "integer",
       "minimum": 1
      },
      "offset": {
       "type": "number"
      }
     }
    }
   ]
  },
  "Picture": {
   "description": "A picture: one of this episode's (assets/images) or the pinned source's, by name.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "asset"
   ],
   "properties": {
    "asset": {
     "type": "string",
     "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "focus": {
     "type": "array",
     "items": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
     },
     "minItems": 2,
     "maxItems": 2
    },
    "aspect": {
     "type": "number",
     "exclusiveMinimum": 0
    }
   }
  },
  "Lower": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "kicker",
    "title"
   ],
   "properties": {
    "kicker": {
     "type": "string",
     "minLength": 1,
     "maxLength": 60
    },
    "title": {
     "type": "string",
     "minLength": 1,
     "maxLength": 60
    },
    "info": {
     "type": "string",
     "minLength": 1,
     "maxLength": 80
    }
   }
  },
  "Chapter": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "n",
    "title"
   ],
   "properties": {
    "n": {
     "type": "string",
     "minLength": 1,
     "maxLength": 30
    },
    "title": {
     "type": "string",
     "minLength": 1,
     "maxLength": 20
    },
    "sub": {
     "type": "string",
     "minLength": 1,
     "maxLength": 80
    }
   }
  },
  "Gesture": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "at",
    "pose"
   ],
   "properties": {
    "at": {
     "$ref": "#/$defs/Cue"
    },
    "pose": {
     "type": "string",
     "minLength": 1,
     "maxLength": 30
    },
    "ex": {
     "enum": [
      "N",
      "A",
      "W",
      "I",
      "M",
      "S"
     ]
    }
   }
  },
  "Timed": {
   "description": "Kit props whose times are cues: the keys at, until, glossAt, lineFrom, appear, lit, point and merge, every member of times, and every element of read and strikes, wherever they sit; a one-key object {asset} names a picture.",
   "type": "object"
  }
 }
}
