{
 "compiler": {
  "id": "dentro-i-versi-long",
  "version": "1.0.0"
 },
 "cases": [
  {
   "name": "the compiled timeline, untouched: only the missing sound theme is noted",
   "set": [],
   "expect": [
    {
     "code": "no-theme-sound",
     "severity": "warning",
     "path": "$.tracks"
    }
   ]
  },
  {
   "name": "a text moved by half a second: within the rules",
   "set": [
    {
     "path": "$.tracks[6].items[0].from",
     "value": 15
    }
   ],
   "expect": [
    {
     "code": "no-theme-sound",
     "severity": "warning",
     "path": "$.tracks"
    }
   ]
  },
  {
   "name": "the loop given up",
   "set": [
    {
     "path": "$.loop",
     "value": false
    }
   ],
   "expect": [
    {
     "code": "loop-broken",
     "severity": "error",
     "path": "$.loop"
    },
    {
     "code": "no-theme-sound",
     "severity": "warning",
     "path": "$.tracks"
    }
   ]
  },
  {
   "name": "the brand mark in another colour",
   "set": [
    {
     "path": "$.tracks[16].items[0].props.look.colors.accent",
     "value": "#ff0000"
    }
   ],
   "expect": [
    {
     "code": "look-changed",
     "severity": "error",
     "path": "$.tracks[16].items[0].props.look"
    },
    {
     "code": "no-theme-sound",
     "severity": "warning",
     "path": "$.tracks"
    }
   ]
  },
  {
   "name": "a guide take moved by a second",
   "set": [
    {
     "path": "$.tracks[18].items[1].from",
     "value": 2000
    }
   ],
   "expect": [
    {
     "code": "voice-changed",
     "severity": "error",
     "path": "$.tracks"
    },
    {
     "code": "no-theme-sound",
     "severity": "warning",
     "path": "$.tracks"
    }
   ]
  },
  {
   "name": "the guide no longer arrives by teleport",
   "set": [
    {
     "path": "$.tracks[5].items[0].props.teleport",
     "value": {}
    }
   ],
   "expect": [
    {
     "code": "missing-teleport",
     "severity": "error",
     "path": "$.tracks[5].items[0].props.teleport"
    },
    {
     "code": "no-theme-sound",
     "severity": "warning",
     "path": "$.tracks"
    }
   ]
  },
  {
   "name": "the opening guide moved off the first frame",
   "set": [
    {
     "path": "$.tracks[5].items[0].from",
     "value": 1
    }
   ],
   "expect": [
    {
     "code": "missing-guide",
     "severity": "error",
     "path": "$.tracks"
    },
    {
     "code": "no-theme-sound",
     "severity": "warning",
     "path": "$.tracks"
    }
   ]
  },
  {
   "name": "the lesson cut to three minutes: too short, and a guide of the middle now at the last frame without leaving",
   "set": [
    {
     "path": "$.durationInFrames",
     "value": 5400
    }
   ],
   "expect": [
    {
     "code": "duration",
     "severity": "error",
     "path": "$.durationInFrames"
    },
    {
     "code": "missing-teleport",
     "severity": "error",
     "path": "$.tracks[5].items[6].props.teleport"
    },
    {
     "code": "no-theme-sound",
     "severity": "warning",
     "path": "$.tracks"
    }
   ]
  },
  {
   "name": "a stage item drawn with a kit of another format",
   "set": [
    {
     "path": "$.tracks[1].items[0].kit",
     "value": {
      "name": "museum-hall",
      "version": "1.0.0"
     }
    }
   ],
   "expect": [
    {
     "code": "unknown-kit",
     "severity": "error",
     "path": "$.tracks[1].items[0].kit"
    },
    {
     "code": "no-theme-sound",
     "severity": "warning",
     "path": "$.tracks"
    }
   ]
  }
 ]
}
