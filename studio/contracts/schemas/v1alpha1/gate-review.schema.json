{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video.studio/schemas/v1alpha1/gate-review.schema.json",
  "title": "Gate review record",
  "description": "The payload carried in the `detail` of an approval-requested, approval-granted or approval-rejected journal event. A review that cannot name the artifacts it examined, by hash, is not a review.",
  "$defs": {
    "ArtifactHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Path relative to the episode directory. Never absolute: a record that names a reviewer's home directory cannot be checked anywhere else."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Lowercase hex sha256 of the file's bytes at the moment of review."
        }
      }
    },
    "GateCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "fail", "warn", "info"] },
        "expected": { "type": "string" },
        "actual": { "type": "string" },
        "evidence": {
          "type": "string",
          "description": "What was examined to reach this status — a path, a measurement, a tool invocation."
        }
      }
    },
    "GateReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stageId", "decision", "origin", "actor", "at", "binding", "checks"],
      "properties": {
        "stageId": { "type": "string", "minLength": 1 },
        "decision": {
          "enum": ["requested", "approved", "rejected"],
          "description": "rejected rides in its own event type, approval-rejected (avg-qr4.3), so no event on disk contradicts itself."
        },
        "origin": {
          "enum": ["human", "agent", "policy"],
          "description": "Who decided, as distinct from `actor`, who wrote the line."
        },
        "actor": { "enum": ["pi", "gateway", "runtime", "human", "system"] },
        "at": { "type": "string", "format": "date-time" },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inputs", "outputs"],
          "properties": {
            "planHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "Lowercase hex sha256 of the plan this decision was bound to. Present on approved and rejected decisions; absent on a bare request."
            },
            "inputs": { "type": "array", "items": { "$ref": "#/$defs/ArtifactHash" } },
            "outputs": { "type": "array", "items": { "$ref": "#/$defs/ArtifactHash" } }
          }
        },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/GateCheck" } },
        "note": { "type": "string" },
        "signature": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Present exactly when origin is human and the decision is approved or rejected. A request is never signed."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "decision": { "const": "approved" } }, "required": ["decision"] },
          "then": {
            "properties": {
              "binding": {
                "type": "object",
                "required": ["planHash"],
                "properties": {
                  "planHash": { "type": "string" },
                  "outputs": { "type": "array", "minItems": 1 }
                }
              }
            },
            "description": "An approval must name at least one artifact and the plan it was bound to. Approving nothing is the bug this issue exists to remove."
          }
        },
        {
          "if": { "properties": { "decision": { "const": "rejected" } }, "required": ["decision"] },
          "then": {
            "required": ["note"],
            "properties": { "note": { "type": "string" } },
            "description": "A rejection nobody can act on is noise."
          }
        },
        {
          "if": {
            "properties": {
              "origin": { "const": "human" },
              "decision": { "enum": ["approved", "rejected"] }
            },
            "required": ["origin", "decision"]
          },
          "then": {
            "required": ["signature"],
            "properties": { "signature": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
            "description": "A human's decision is signed; an unsigned human decision is indistinguishable from a forged one."
          }
        }
      ]
    }
  }
}
