{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video.studio/schemas/v1alpha1/edit-timeline.schema.json",
  "title": "Video Studio edit timeline schema",
  "description": "Deprecated: superseded by v1alpha2 (ADR-0034); kept frozen for migration. Canonical schema for the edit timeline — a declarative, reviewable account of how visual and audio assets are arranged over time. Owned by video-workspace-contracts per ADR-0028. Maps to the ffmpeg-video-composer Timeline input type.",
  "$defs": {
    "EpisodeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "series", "episode"],
      "properties": {
        "channel": { "type": "string", "minLength": 1 },
        "series": { "type": "string", "minLength": 1 },
        "episode": { "type": "string", "minLength": 1 }
      }
    },
    "Resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 7680 },
        "height": { "type": "integer", "minimum": 1, "maximum": 4320 }
      }
    },
    "AssetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "hash": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 }
      }
    },
    "SegmentTransition": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "duration"],
      "properties": {
        "type": { "type": "string", "enum": ["dissolve", "fade", "wipe", "none"] },
        "duration": { "type": "number", "minimum": 0 },
        "easing": { "type": "string" }
      }
    },
    "SegmentCaption": {
      "type": "object",
      "additionalProperties": true,
      "required": ["text", "start", "duration"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "start": { "type": "number", "minimum": 0 },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "font": { "type": "string" },
        "fontSize": { "type": "number", "exclusiveMinimum": 0 },
        "color": { "type": "string" },
        "backgroundColor": { "type": "string" },
        "position": { "type": "string", "enum": ["top", "bottom", "center"] },
        "offsetY": { "type": "number" }
      }
    },
    "SegmentAudio": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "volume": { "type": "number", "minimum": 0 },
        "fadeIn": { "type": "number", "minimum": 0 },
        "fadeOut": { "type": "number", "minimum": 0 },
        "mute": { "type": "boolean" }
      }
    },
    "VisualTransform": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "crop": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "type": "number", "minimum": 0 },
            "y": { "type": "number", "minimum": 0 },
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "fit": { "type": "string", "enum": ["contain", "cover", "fill", "none"] },
        "scale": { "type": "number", "exclusiveMinimum": 0 },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          }
        }
      }
    },
    "VideoFilter": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "params": { "type": "object", "additionalProperties": true }
      }
    },
    "Segment": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "sourceAsset", "startSec", "durationSec"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sourceAsset": { "type": "string", "minLength": 1 },
        "sourceKind": {
          "type": "string",
          "enum": ["markdown", "json", "yaml", "audio", "video", "image", "captions", "tape", "directory"]
        },
        "startSec": { "type": "number", "minimum": 0 },
        "durationSec": { "type": "number", "exclusiveMinimum": 0 },
        "transition": { "$ref": "#/$defs/SegmentTransition" },
        "caption": { "$ref": "#/$defs/SegmentCaption" },
        "audio": { "$ref": "#/$defs/SegmentAudio" },
        "transform": { "$ref": "#/$defs/VisualTransform" },
        "filters": {
          "type": "array",
          "items": { "$ref": "#/$defs/VideoFilter" }
        }
      }
    },
    "TimelineCaption": {
      "type": "object",
      "additionalProperties": true,
      "required": ["text", "segmentIndex", "start", "duration"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "segmentIndex": { "type": "integer", "minimum": 0 },
        "start": { "type": "number", "minimum": 0 },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "font": { "type": "string" },
        "fontSize": { "type": "number", "exclusiveMinimum": 0 },
        "color": { "type": "string" },
        "backgroundColor": { "type": "string" },
        "position": { "type": "string", "enum": ["top", "bottom", "center"] }
      }
    },
    "TimelineTransition": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "afterSegmentIndex", "duration"],
      "properties": {
        "type": { "type": "string", "enum": ["dissolve", "fade", "wipe", "none"] },
        "afterSegmentIndex": { "type": "integer", "minimum": 0 },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "easing": { "type": "string" }
      }
    },
    "EditTimeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "episodeRef", "revision", "fps", "resolution", "segments"],
      "properties": {
        "apiVersion": {
          "type": "string",
          "const": "studio.video/v1alpha1"
        },
        "kind": {
          "type": "string",
          "const": "EditTimeline"
        },
        "episodeRef": { "$ref": "#/$defs/EpisodeRef" },
        "revision": { "type": "integer", "minimum": 1 },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "resolution": { "$ref": "#/$defs/Resolution" },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Segment" }
        },
        "captions": {
          "type": "array",
          "items": { "$ref": "#/$defs/TimelineCaption" }
        },
        "transitions": {
          "type": "array",
          "items": { "$ref": "#/$defs/TimelineTransition" }
        },
        "codec": { "type": "string" },
        "pixelFormat": { "type": "string" }
      }
    }
  }
}
