{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video.studio/schemas/v1alpha1/pipeline-manifest.schema.json",
  "title": "Video Studio pipeline manifest schema",
  "description": "Canonical schema for pipeline manifests. Owned by video-workspace-contracts per ADR-0024. Stages are typed editorial (executed by Pi via skills) or capability (require a recorded binding per ADR-0025/0026).",
  "$defs": {
    "SemVer": {
      "type": "string",
      "description": "Semantic version per semver.org",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "ContractRef": {
      "type": "object",
      "additionalProperties": true,
      "required": ["contract", "version"],
      "properties": {
        "contract": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "SkillRef": {
      "type": "object",
      "additionalProperties": true,
      "required": ["skill", "version"],
      "properties": {
        "skill": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "StageGates": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "autopilot": { "type": "boolean" },
        "review": { "type": "string", "enum": ["none", "human", "auto", "skill", "human-or-skill"] },
        "retry_on_failure": { "type": "integer", "minimum": 0 }
      }
    },
    "PipelineStage": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["editorial", "capability"] },
        "capability": { "type": "string", "minLength": 1 },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/ContractRef" } },
        "outputs": { "type": "array", "items": { "$ref": "#/$defs/ContractRef" } },
        "gates": { "$ref": "#/$defs/StageGates" },
        "skills": { "type": "array", "items": { "$ref": "#/$defs/SkillRef" } },
        "depends_on": { "type": "array", "items": { "type": "string" } }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "capability" } }, "required": ["type"] },
          "then": { "required": ["capability"], "properties": { "capability": { "type": "string" } } }
        },
        {
          "if": { "properties": { "type": { "const": "editorial" } }, "required": ["type"] },
          "then": { "not": { "required": ["capability"], "properties": { "capability": { "type": "string" } } } }
        }
      ]
    },
    "CapabilityDecl": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "PipelineExtends": {
      "type": "object",
      "additionalProperties": true,
      "required": ["pipeline"],
      "properties": {
        "pipeline": { "type": "string", "minLength": 1 },
        "version": { "type": "string" }
      }
    },
    "PipelineManifest": {
      "type": "object",
      "additionalProperties": true,
      "required": ["pipeline"],
      "properties": {
        "pipeline": {
          "type": "object",
          "additionalProperties": true,
          "required": ["id", "version", "stages"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
            "version": { "$ref": "#/$defs/SemVer" },
            "description": { "type": "string" },
            "extends": { "$ref": "#/$defs/PipelineExtends" },
            "capabilities": { "type": "array", "items": { "$ref": "#/$defs/CapabilityDecl" } },
            "stages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/PipelineStage" } }
          }
        }
      }
    }
  }
}
