{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video.studio/schemas/v1alpha1/execution-event.schema.json",
  "title": "Execution event payloads",
  "description": "The `data` payloads of the journal events that execution state is replayed from. Every one carries leaseId and attemptNumber: a stage attempted three times produces three interleaved runs of events, and without both a reader cannot tell which stage-failed closes which stage-started.",
  "$defs": {
    "StageLeased": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stageId", "leaseId", "attemptNumber", "ttlMs", "expiresAt", "holder"],
      "properties": {
        "stageId": { "type": "string", "minLength": 1 },
        "leaseId": { "type": "string", "minLength": 1 },
        "attemptNumber": { "type": "integer", "minimum": 1 },
        "ttlMs": { "type": "integer", "minimum": 1 },
        "expiresAt": { "type": "string", "format": "date-time" },
        "holder": {
          "type": "string",
          "minLength": 1,
          "description": "Who took the lease, so an expired one reports as held by X until T rather than as an anonymous block."
        },
        "attended": {
          "const": true,
          "description": "Present when an operator took the stage (avg-qr4.3)."
        }
      }
    },
    "StageStarted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stageId", "leaseId", "attemptNumber"],
      "properties": {
        "stageId": { "type": "string", "minLength": 1 },
        "leaseId": { "type": "string", "minLength": 1 },
        "attemptNumber": { "type": "integer", "minimum": 1 }
      }
    },
    "StageCompleted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stageId", "leaseId", "attemptNumber", "outputs"],
      "properties": {
        "stageId": { "type": "string", "minLength": 1 },
        "leaseId": { "type": "string", "minLength": 1 },
        "attemptNumber": { "type": "integer", "minimum": 1 },
        "outputs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "digests": {
          "type": "array",
          "description": "Every file the outputs name, hashed, with a read-only copy kept under attempts/<stageId>/<attemptNumber>/ (avg-qr4.6). Present makes this completion a candidate; absent is a completion from before candidates were kept.",
          "items": { "$ref": "#/$defs/FileDigest" }
        },
        "selected": {
          "type": "boolean",
          "description": "False when the candidate was kept but did not become the stage's take, because the operator's selected take is locked. Absent means selected."
        },
        "durationMs": { "type": "integer", "minimum": 0 }
      }
    },
    "FileDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "description": "Relative to the episode directory." },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "TakeSelected": {
      "type": "object",
      "additionalProperties": false,
      "description": "Which candidate is a stage's take (avg-qr4.6). Shaped like a gate review so an operator's selection is signed by the same receipt and a retyped line reads as tampered.",
      "required": ["stageId", "decision", "origin", "actor", "at", "binding", "episode"],
      "properties": {
        "stageId": { "type": "string", "minLength": 1 },
        "decision": { "const": "selected" },
        "origin": { "enum": ["human", "agent", "policy"] },
        "actor": { "enum": ["pi", "gateway", "runtime", "human", "system"] },
        "at": { "type": "string", "format": "date-time" },
        "episode": { "type": "string", "minLength": 1 },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["attemptNumber", "leaseId", "outputs"],
          "properties": {
            "attemptNumber": { "type": "integer", "minimum": 1 },
            "leaseId": { "type": "string", "minLength": 1 },
            "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/FileDigest" } }
          }
        },
        "previous": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "The attempt that was selected when this was decided, or null for none. Informational: the compare-and-swap happened under the stage lock."
        },
        "signature": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "Money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "micros"],
      "properties": {
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "micros": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "SpendReserved": {
      "type": "object",
      "additionalProperties": false,
      "description": "A paid call is about to reach its provider (avg-91o). Appended under the episode's budget lock after checking the estimate against the budget; counts against it until settled or released.",
      "required": ["reserveId", "capability", "provider", "estimate"],
      "properties": {
        "reserveId": { "type": "string", "pattern": "^rsv_[0-9A-HJKMNP-TV-Z]{26}$" },
        "capability": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "profile": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "estimate": { "$ref": "#/$defs/Money" },
        "priced": { "const": false, "description": "Present only when no price is known for the model, so the estimate is a placeholder 0." }
      }
    },
    "SpendSettled": {
      "type": "object",
      "additionalProperties": false,
      "description": "The call went out. `basis` says whether `cost` is what the provider reported or the estimate standing in for a figure it did not send.",
      "required": ["reserveId", "cost", "basis"],
      "properties": {
        "reserveId": { "type": "string", "pattern": "^rsv_[0-9A-HJKMNP-TV-Z]{26}$" },
        "cost": { "$ref": "#/$defs/Money" },
        "basis": { "enum": ["provider", "estimate"] },
        "providerRequestId": { "type": "string", "minLength": 1 }
      }
    },
    "SpendReleased": {
      "type": "object",
      "additionalProperties": false,
      "description": "Nothing was spent: the call never reached the provider, the provider refused it, or the operator closed a reservation after checking.",
      "required": ["reserveId", "reason"],
      "properties": {
        "reserveId": { "type": "string", "pattern": "^rsv_[0-9A-HJKMNP-TV-Z]{26}$" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "StageFailed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stageId", "leaseId", "attemptNumber", "error"],
      "properties": {
        "stageId": { "type": "string", "minLength": 1 },
        "leaseId": { "type": "string", "minLength": 1 },
        "attemptNumber": { "type": "integer", "minimum": 1 },
        "error": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "durationMs": { "type": "integer", "minimum": 0 }
      }
    },
    "AttemptRecorded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stageId", "leaseId", "attemptNumber", "outcome"],
      "properties": {
        "stageId": { "type": "string", "minLength": 1 },
        "leaseId": { "type": "string", "minLength": 1 },
        "attemptNumber": { "type": "integer", "minimum": 1 },
        "outcome": { "enum": ["success", "failure", "timeout"] },
        "outputs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
