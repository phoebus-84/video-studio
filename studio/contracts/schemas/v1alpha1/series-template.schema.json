{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.studio.video/v1alpha1/series-template.schema.json",
  "title": "Versioned series templates, episode specs and golden references (ADR-0037)",
  "$defs": {
    "TemplateVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "description": "An exact released version, never a range, tag or latest."
    },
    "SeriesComponentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "identity.schema.json#/$defs/Slug" },
        "version": { "$ref": "#/$defs/TemplateVersion" },
        "bundle": { "$ref": "#/$defs/CodeBundle" }
      },
      "description": "The compiler or validator the release runs: with `bundle`, the release's own sealed code (avg-d1x); without, the application's registered one."
    },
    "KitPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "level", "hash"],
      "properties": {
        "name": { "$ref": "identity.schema.json#/$defs/Slug" },
        "version": { "$ref": "#/$defs/TemplateVersion" },
        "level": { "enum": ["channel", "series"], "description": "library/<channel>/kits/ or library/<channel>/series/<series>/kits/." },
        "hash": { "$ref": "identity.schema.json#/$defs/ContentHash", "description": "sha256 of the kit release's kit.json." }
      }
    },
    "CodeBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "hash"],
      "properties": {
        "path": { "type": "string", "pattern": "^(compiler|validator)/[a-z0-9][a-z0-9._-]*\\.cjs$" },
        "hash": { "$ref": "identity.schema.json#/$defs/ContentHash" }
      },
      "description": "A self-contained CommonJS module built by `vpr template seal` from the release's source, relative to the release; `hash` is its sha256."
    },
    "TemplatePin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "hash"],
      "properties": {
        "id": { "$ref": "identity.schema.json#/$defs/Slug" },
        "version": { "$ref": "#/$defs/TemplateVersion" },
        "hash": { "$ref": "identity.schema.json#/$defs/ContentHash" }
      },
      "description": "Hash of the exact UTF-8 series-template.json bytes; the manifest pins every other release file."
    },
    "SeriesEpisodeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "series", "episode"],
      "properties": {
        "channel": { "$ref": "identity.schema.json#/$defs/Slug" },
        "series": { "$ref": "identity.schema.json#/$defs/Slug" },
        "episode": { "$ref": "identity.schema.json#/$defs/Slug" }
      }
    },
    "SeriesFileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "hash"],
      "properties": {
        "path": { "$ref": "identity.schema.json#/$defs/PortableRelativePath" },
        "hash": { "$ref": "identity.schema.json#/$defs/ContentHash" }
      }
    },
    "SheetInstantRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at"],
      "properties": {
        "at": { "enum": ["start", "middle", "end"], "description": "Where in each matching section: its first frame, its middle, its last frame." },
        "offsetSeconds": { "type": "number", "description": "Shift from the anchor, in seconds; may be negative." },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\*?$" },
          "description": "Section ids this rule applies to: an exact id (a timeline LocalId), or a prefix ending in * (block-*). Absent: every section."
        }
      },
      "description": "One instant per matching section of the edit timeline, added to the layout sheet's defaults (avg-3th.1)."
    },
    "SheetRules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instants"],
      "properties": {
        "instants": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/SheetInstantRule" } }
      },
      "description": "The instants this series' layout sheets always show, besides the first and last frame and a spread over the sections."
    },
    "SeriesTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "id", "version", "compiler", "files"],
      "properties": {
        "apiVersion": { "const": "studio.video/v1alpha1" },
        "kind": { "const": "SeriesTemplate" },
        "id": { "$ref": "identity.schema.json#/$defs/Slug" },
        "version": { "$ref": "#/$defs/TemplateVersion" },
        "compiler": { "$ref": "#/$defs/SeriesComponentRef" },
        "validator": { "$ref": "#/$defs/SeriesComponentRef" },
        "theme": { "$ref": "channel-theme.schema.json#/$defs/ThemePin", "description": "The channel theme release this series draws with (ADR-0040); absent: the kits' own look." },
        "kits": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/KitPin" },
          "description": "The library kits this series' timelines may draw with besides the application's (avg-d1x): the channel's or the series' own, each pinned by the hash of its kit.json."
        },
        "files": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "template", "standard"],
          "properties": {
            "schema": { "$ref": "#/$defs/SeriesFileRef" },
            "template": { "$ref": "#/$defs/SeriesFileRef" },
            "standard": { "$ref": "#/$defs/SeriesFileRef" }
          }
        },
        "sheet": { "$ref": "#/$defs/SheetRules" },
        "metadata": { "type": "object", "additionalProperties": true }
      }
    },
    "EpisodeSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "episodeRef", "revision", "template", "data"],
      "properties": {
        "apiVersion": { "const": "studio.video/v1alpha1" },
        "kind": { "const": "EpisodeSpec" },
        "episodeRef": { "$ref": "#/$defs/SeriesEpisodeRef" },
        "revision": { "$ref": "identity.schema.json#/$defs/RevisionNumber" },
        "template": { "$ref": "#/$defs/TemplatePin" },
        "data": {
          "type": "object",
          "description": "Editable series-specific data, checked against the pinned series schema. Drafts may contain __FILL__; compilation must reject them."
        },
        "metadata": { "type": "object", "additionalProperties": true }
      }
    },
    "SeriesReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "id", "episodeRef", "template", "spec", "timeline", "render", "report", "approval"],
      "properties": {
        "apiVersion": { "const": "studio.video/v1alpha1" },
        "kind": { "const": "SeriesReference" },
        "id": { "$ref": "identity.schema.json#/$defs/Slug" },
        "episodeRef": { "$ref": "#/$defs/SeriesEpisodeRef" },
        "template": { "$ref": "#/$defs/TemplatePin" },
        "spec": { "$ref": "#/$defs/SeriesFileRef" },
        "timeline": { "$ref": "#/$defs/SeriesFileRef" },
        "render": { "$ref": "#/$defs/SeriesFileRef" },
        "report": { "$ref": "#/$defs/SeriesFileRef" },
        "approval": {
          "$ref": "https://video.studio/schemas/v1alpha1/gate-review.schema.json#/$defs/GateReview",
          "description": "Preserved human approval receipt bound to these exact artifacts. Shape is not proof: the runtime must verify its signature and the files before trusting a reference."
        },
        "metadata": { "type": "object", "additionalProperties": true }
      }
    }
  }
}
