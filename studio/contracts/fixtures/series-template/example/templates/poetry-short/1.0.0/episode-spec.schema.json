{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/poetry-short/1.0.0/episode-spec.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "narration",
    "holdSeconds",
    "panels",
    "style"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "narration": {
      "type": "string",
      "minLength": 1
    },
    "holdSeconds": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "panels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Panel"
      }
    },
    "style": {
      "const": {
        "fontFamily": "Georgia",
        "captionKit": {
          "name": "captions",
          "version": "1.1.0"
        },
        "voiceProfile": "narrator-v1",
        "outputProfile": "vertical-1080x1920"
      }
    }
  },
  "$defs": {
    "Panel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "cue"
      ],
      "properties": {
        "assetId": {
          "type": "string",
          "minLength": 1
        },
        "cue": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
