{
  "name": "video-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agentic Video Studio \u2014 a Pi-directed video production system. `packages/*` are reusable outside this project; `studio/*` is the product built on top of them.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.2.0",
  "workspaces": [
    "packages/blender",
    "packages/codex-image",
    "packages/fal-media",
    "packages/graphics",
    "packages/infographics",
    "packages/terminal-recorder",
    "packages/video-composer",
    "studio/contracts",
    "studio/runtime",
    "studio/pipelines",
    "studio/agent",
    "studio/gateway",
    "studio/web"
  ],
  "scripts": {
    "compose": "node tools/compose.mjs",
    "postinstall": "node tools/compose.mjs --sync-skills --quiet && node tools/build-required.mjs",
    "check:paths": "node tools/check-no-foreign-paths.mjs",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "check:contracts": "npm run check --workspace @studio/contracts",
    "check:pipelines": "node studio/pipelines/lint/validate-pipeline.js studio/pipelines/pipelines/*.yaml",
    "check": "npm run check:paths && npm run check:boundaries && npm run check:contracts && npm run check:pipelines && npm run docs:check && npm run typecheck && npm test",
    "test:tools": "node --test tools/test/*.test.mjs",
    "test": "npm run test:tools && node tools/run-all.mjs test",
    "typecheck": "node tools/run-all.mjs typecheck",
    "doctor": "node tools/doctor.mjs",
    "smoke:blender": "node --import tsx tools/smoke-blender-harness.mjs",
    "docs:generate": "node tools/gen-docs.mjs && npm run docs:sync",
    "docs:check": "node tools/gen-docs.mjs --check",
    "build": "node tools/run-all.mjs build",
    "docs:sync": "node tools/sync-doc-sources.mjs",
    "docs:dev": "npm run docs:generate && vitepress dev docs",
    "docs:build": "npm run docs:generate && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "vitepress": "^1.6.4"
  },
  "dependencies": {
    "@studio/contracts": "workspace:*"
  }
}
